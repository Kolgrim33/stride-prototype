rules_version = '2';
// Browsers never read or write Firestore directly. All data goes through the Stride server
// (server/handler.js), which checks the Google sign-in and applies the access rules, using the
// Admin SDK, which bypasses these rules. So the rules deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
